{
  "base_model": "Qwen/Qwen2.5-0.5B-Instruct",
  "dtype": "float32",
  "device": "cpu",
  "max_length": 256,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.0,
  "target_modules": ["q_proj", "v_proj"],
  "learning_rate": 2e-4,
  "batch_size": 2,
  "grad_accum": 4,
  "max_steps": 150,
  "warmup_steps": 20,
  "grad_clip": 1.0,
  "val_every": 30,
  "seed": 0,
  "output_dir": "outputs/sft_run",
  "merge": false
}
