+  assert.equal(learning.currentResult(week1.id, 'rewrite'), 'user_passed');
+  assert.equal(learning.currentEvidence(week1.id, 'rewrite'), '对照通过');
+  assert.equal(learning.failedHistory(week1.id, 'rewrite').length, 1);
