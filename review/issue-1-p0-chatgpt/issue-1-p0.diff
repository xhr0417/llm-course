+function softmaxRows(matrix) {
+  return matrix.map(row => {
+    const max = Math.max(...row);
+    const exps = row.map(value => Math.exp(value - max));
+    const sum = exps.reduce((total, value) => total + value, 0);
+    return exps.map(value => value / sum);
+  });
+}
