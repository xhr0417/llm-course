+            history: []
+          }
+        },
+        concepts: {},
+        reviews: {}
+      })
+    }
+  });
+  await harness.waitFor(() => /手写因果多头注意力/.test(app.text()));
+  app.content.querySelector('[data-stage="claim-agent"]').click();
